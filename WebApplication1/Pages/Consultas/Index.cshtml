@page
@model WebApplication1.Pages.Consultas.IndexModel
@{
    ViewData["Title"] = "Consultas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Consultas</h1>
    <a asp-page="Create" class="btn btn-primary">+ Nova consulta</a>
</div>

@if (Model.Mensagem is not null)
{
    <div class="alert alert-success">@Model.Mensagem</div>
}
@if (Model.Erro is not null)
{
    <div class="alert alert-danger">@Model.Erro</div>
}

<input type="text" id="filtro" class="form-control mb-3" placeholder="Buscar por paciente ou profissional..." />

@if (!Model.Consultas.Any())
{
    <p class="text-muted">Nenhuma consulta cadastrada.</p>
}
else
{
    <table class="table table-striped align-middle" id="tabela-consultas">
        <thead>
        <tr>
            <th>Data/Hora</th>
            <th>Paciente</th>
            <th>Profissional</th>
            <th>Status</th>
            <th>Observação</th>
            <th class="text-end">Ações</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var consulta in Model.Consultas)
        {
            var badge = consulta.Status switch
            {
                "Agendada" => "bg-primary",
                "Realizada" => "bg-success",
                "Cancelada" => "bg-secondary",
                _ => "bg-light text-dark"
            };
            <tr>
                <td>@consulta.DataHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>@consulta.PacienteNome</td>
                <td>@consulta.ProfissionalNome</td>
                <td><span class="badge @badge">@consulta.Status</span></td>
                <td>@(consulta.Observacao ?? "-")</td>
                <td class="text-end">
                    @if (consulta.Status == "Agendada")
                    {
                        <a asp-page="Reagendar" asp-route-id="@consulta.Id" class="btn btn-sm btn-outline-secondary">Reagendar</a>
                        <form method="post" asp-page-handler="Realizar" asp-route-id="@consulta.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Realizar</button>
                        </form>
                        <form method="post" asp-page-handler="Cancelar" asp-route-id="@consulta.Id" class="d-inline"
                              onsubmit="return confirm('Cancelar esta consulta?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        document.getElementById('filtro')?.addEventListener('input', function () {
            const termo = this.value.toLowerCase();
            document.querySelectorAll('#tabela-consultas tbody tr').forEach(function (linha) {
                linha.style.display = linha.textContent.toLowerCase().includes(termo) ? '' : 'none';
            });
        });
    </script>
}
