@page "{id:guid}"
@model WebApplication1.Pages.Profissionais.EditModel
@{
    ViewData["Title"] = "Editar profissional";
}

<h1>Editar profissional</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post" class="row g-3" style="max-width: 640px;">
    <div class="col-md-8">
        <label asp-for="Input.Nome" class="form-label"></label>
        <input asp-for="Input.Nome" class="form-control"/>
        <span asp-validation-for="Input.Nome" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.Telefone" class="form-label"></label>
        <input asp-for="Input.Telefone" class="form-control"/>
        <span asp-validation-for="Input.Telefone" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label">Tipo</label>
        <input class="form-control" value="@Model.Input.TipoProfissional" readonly/>
    </div>

    <div class="col-md-6">
        <label class="form-label">CRO</label>
        <input class="form-control" value="@(Model.Input.Cro ?? "-")" readonly/>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
