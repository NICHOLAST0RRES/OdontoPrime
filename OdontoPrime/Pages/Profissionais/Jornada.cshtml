@page "{id:guid}"
@model OdontoPrime.Pages.Profissionais.JornadaModel
@using OdontoPrime.Domain.Models
@{
    ViewData["Title"] = "Jornada";
}

<div class="op-page-head">
    <h1>Jornada de @Model.NomeDoDentista</h1>
</div>

<div class="op-form-card">
<div asp-validation-summary="All" class="text-danger"></div>

<p class="text-muted mb-3">
    Deixe em branco os períodos em que o dentista não atende. Os horários andam de 15 em 15 minutos.
</p>

<form method="post">
    <div class="op-table-wrap">
    <table class="table align-middle" id="tabela-jornada">
        <thead>
        <tr>
            <th>Dia</th>
            <th>1º período</th>
            <th>2º período</th>
        </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Dias.Count; i++)
        {
            var dia = Model.Dias[i];
            <tr>
                <td>
                    <input type="hidden" name="Dias[@i].Dia" value="@((int)dia.Dia)"/>
                    @PeriodoDeTrabalho.NomeDoDia(dia.Dia)
                </td>
                <td>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="time" step="900" name="Dias[@i].Inicio1" value="@dia.Inicio1?.ToString("HH:mm")" class="form-control form-control-sm"/>
                        <span>às</span>
                        <input type="time" step="900" name="Dias[@i].Fim1" value="@dia.Fim1?.ToString("HH:mm")" class="form-control form-control-sm"/>
                    </div>
                </td>
                <td>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="time" step="900" name="Dias[@i].Inicio2" value="@dia.Inicio2?.ToString("HH:mm")" class="form-control form-control-sm"/>
                        <span>às</span>
                        <input type="time" step="900" name="Dias[@i].Fim2" value="@dia.Fim2?.ToString("HH:mm")" class="form-control form-control-sm"/>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar jornada</button>
        <button type="button" id="copiar-segunda" class="btn btn-outline-secondary">Copiar segunda para terça a sexta</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
</div>

@section Scripts {
    <script>
        // Atalho: a maioria das clínicas repete o horário de segunda nos outros dias úteis.
        document.getElementById('copiar-segunda').addEventListener('click', function () {
            const linhas = document.querySelectorAll('#tabela-jornada tbody tr');
            const horariosDeSegunda = Array.from(linhas[0].querySelectorAll('input[type=time]')).map(c => c.value);

            for (let i = 1; i <= 4; i++) {   // terça (1) a sexta (4)
                linhas[i].querySelectorAll('input[type=time]').forEach((campo, j) => campo.value = horariosDeSegunda[j]);
            }
        });
    </script>
}
