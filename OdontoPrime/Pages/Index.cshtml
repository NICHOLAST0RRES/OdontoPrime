@page
@model IndexModel
@{
    ViewData["Title"] = "Início";
}

<section class="op-hero mb-4">
    <div class="d-flex align-items-center gap-4 flex-wrap">
        <img src="~/img/odontoprime-mark.png" alt="OdontoPrime" class="op-hero__logo"/>
        <div>
            <h1 class="display-6 mb-0">Bem-vindo à OdontoPrime</h1>
            <p>Visão geral do dia · @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")</p>
        </div>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card op-stat h-100">
            <div class="card-body">
                <span class="op-stat__icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <p class="op-stat__value">@Model.TotalPacientes</p>
                <p class="op-stat__label">Pacientes ativos</p>
                <a asp-page="/Pacientes/Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card op-stat h-100">
            <div class="card-body">
                <span class="op-stat__icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v2a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M6 21v-2a6 6 0 0 1 12 0v2"/></svg>
                </span>
                <p class="op-stat__value">@Model.TotalProfissionais</p>
                <p class="op-stat__label">Profissionais ativos</p>
                <a asp-page="/Profissionais/Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card op-stat h-100">
            <div class="card-body">
                <span class="op-stat__icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>
                <p class="op-stat__value">@Model.ConsultasHoje</p>
                <p class="op-stat__label">Consultas hoje</p>
                <a asp-page="/Consultas/Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
</div>

<div class="op-page-head">
    <h2 class="h4 mb-0">Próximas consultas</h2>
    <a asp-page="/Consultas/Create" class="btn btn-primary btn-sm">+ Nova consulta</a>
</div>

@if (!Model.ProximasConsultas.Any())
{
    <div class="op-empty">Nenhuma consulta agendada.</div>
}
else
{
    <div class="op-table-wrap">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Data/Hora</th>
                <th>Paciente</th>
                <th>Profissional</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var consulta in Model.ProximasConsultas)
            {
                <tr>
                    <td>@consulta.DataHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@consulta.PacienteNome</td>
                    <td>@consulta.ProfissionalNome</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
